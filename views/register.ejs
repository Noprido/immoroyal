<%- include('partials/header', { title: 'Inscription' }) %>
<%- include('partials/navbar') %>

<div class="auth-page">
  <div class="auth-card" style="max-width:520px;">
    <div class="auth-logo">
      <h2>IMMOROYAL</h2>
      <p>Créez votre compte gratuitement</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><i class='bx bx-error-circle'></i> <%= error %></div><% } %>

    <form action="/register" method="POST" style="display:flex; flex-direction:column; gap:1.2rem;">
      <div class="form-group">
        <label class="form-label">Nom complet *</label>
        <input type="text" name="nom" id="nom" class="form-control"
              placeholder="Steed Noumon" required maxlength="100"
              pattern="^[A-Za-zÀ-ÖØ-öø-ÿ' -]+$"
              title="Uniquement des lettres, espaces, tirets et apostrophes">
      </div>
      <div class="form-group">
        <label class="form-label">Téléphone *</label>
        <input type="tel" name="telephone" id="telephone" class="form-control"
              placeholder="+229 01 97 00 00 00" required
              pattern="^\+?[0-9\s\-\.]{8,17}$"
              title="8 à 15 chiffres, espaces/tirets/points tolérés">
      </div>

      <!-- WhatsApp -->
      <div class="form-group">
        <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-size:0.9rem; color:var(--dark);">
          <input type="checkbox" name="whatsappSame" id="whatsappSame" value="1" checked
                 onchange="toggleWhatsapp(this)"
                 style="width:16px; height:16px; accent-color:var(--gold); cursor:pointer;">
          <span>Mon numéro WhatsApp est le même que mon téléphone</span>
        </label>
      </div>
      <div class="form-group" id="whatsappField" style="display:none;">
        <label class="form-label">Numéro WhatsApp</label>
        <input type="tel" name="whatsapp" id="whatsapp" class="form-control"
              placeholder="+229 97 00 00 00"
              pattern="^\+?[0-9\s\-\.]{8,17}$"
              title="8 à 15 chiffres, espaces/tirets/points tolérés">
      </div>

      <div class="form-group">
        <label class="form-label">Mot de passe *</label>
        <input type="password" name="password" id="password" class="form-control"
            placeholder="Min. 6 caractères" required minlength="6" maxlength="72">
      </div>
      <div class="form-group">
        <label class="form-label">Confirmer le mot de passe *</label>
        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control"
              placeholder="••••••••" required minlength="6" maxlength="72">
      </div>

      <!-- hidden crsfToken -->
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <button type="submit" class="btn btn-gold btn-full btn-lg">Créer mon compte</button>
    </form>

    <div class="gold-line"></div>
    <p style="text-align:center; font-size:0.9rem; color:#6B6B6B;">
      Déjà un compte ? <a href="/login" style="color:#D4AF37; font-weight:600;">Se connecter</a>
    </p>
  </div>
</div>

<script>
function toggleWhatsapp(checkbox) {
  const field = document.getElementById('whatsappField');
  const input = document.getElementById('whatsapp');
  if (checkbox.checked) {
    field.style.display = 'none';
    input.removeAttribute('required');
    input.value = '';
  } else {
    field.style.display = 'flex';
    input.setAttribute('required', 'required');
    input.focus();
  }
}

document.querySelector('form[action="/register"]').addEventListener('submit', function(e) {
  const nom = document.getElementById('nom');
  const telephone = document.getElementById('telephone');
  const whatsappSame = document.getElementById('whatsappSame');
  const whatsapp = document.getElementById('whatsapp');
  const password = document.getElementById('password');
  const confirmPassword = document.getElementById('confirmPassword');
  let messages = [];

  const nomTrim = nom.value.trim();
  const nomRegexClient = /^[A-Za-zÀ-ÖØ-öø-ÿ' -]+$/;
  if (!nomTrim) {
    messages.push('Le nom est obligatoire.');
  } else if (!nomRegexClient.test(nomTrim)) {
    messages.push('Le nom ne peut contenir que des lettres, espaces, tirets et apostrophes.');
  } else {
    const nbLettres = (nomTrim.match(/[A-Za-zÀ-ÖØ-öø-ÿ]/g) || []).length;
    if (nbLettres < 2) messages.push('Veuillez saisir un nom valide.');
  }

  const telClean = telephone.value.replace(/[\s\-\.]/g, '');
  if (!/^\+?[0-9]{8,15}$/.test(telClean)) {
    messages.push('Le format du numéro de téléphone est invalide.');
  }

  if (!whatsappSame.checked) {
    const waClean = whatsapp.value.replace(/[\s\-\.]/g, '');
    if (!/^\+?[0-9]{8,15}$/.test(waClean)) {
      messages.push('Le format du numéro WhatsApp est invalide.');
    }
  }

  if (password.value.length < 6) {
    messages.push('Le mot de passe doit contenir au moins 6 caractères.');
  }
  if (password.value !== confirmPassword.value) {
    messages.push('Les mots de passe ne correspondent pas.');
  }

  if (messages.length > 0) {
    e.preventDefault();
    afficherErreursClient(messages);
  }
});

function afficherErreursClient(messages) {
  const existant = document.querySelector('.alert-error-client');
  if (existant) existant.remove();

  const div = document.createElement('div');
  div.className = 'alert alert-error alert-error-client';
  div.innerHTML = `<i class='bx bx-error-circle'></i> ${messages[0]}`;

  const form = document.querySelector('form[action="/register"]');
  form.parentNode.insertBefore(div, form);
}
</script>

<%- include('partials/footer') %>
