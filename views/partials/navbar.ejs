<nav class="navbar">
  <a href="/" class="navbar-brand">
    <span>IMMO<span style="color:#fff">ROYAL</span></span>
  </a>

  <button class="navbar-burger" id="burgerBtn" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>

  <div class="navbar-links" id="navbarLinks">
    <a href="/annonces" class="nav-link">Annonces</a>
    <a href="/apropos" class="nav-link">À propos</a>
    <a href="/recherches" class="nav-link">Je cherche</a>
    <a href="/contact" class="nav-link">Contact</a>

    <% if (user) { %>
      <a href="/annonces/creer" class="nav-link">Publier</a>
      <a href="/messages" id="navMessagesLink" class="nav-link" style="position:relative;">
        Messages
        <% if (totalNonLus > 0) { %>
          <span id="navBadge" style="position:absolute; top:-6px; right:-10px; background:#dc3545; color:#fff; border-radius:50%; font-size:9px; font-weight:800; min-width:16px; height:16px; display:flex; align-items:center; justify-content:center; padding:0 3px;">
            <%= totalNonLus > 99 ? '99+' : totalNonLus %>
          </span>
        <% } %>
      </a>

      <!-- Dropdown compte -->
      <div class="nav-dropdown" id="navDropdown">
        <button class="nav-dropdown-btn" onclick="toggleDropdown()">
          <i class='bx bx-user-circle'></i> Mon compte <i class='bx bx-chevron-down' id="dropdownChevron"></i>
        </button>
        <div class="nav-dropdown-menu" id="navDropdownMenu">
          <a href="/profile/dashboard" class="nav-dropdown-item">
            <i class='bx bx-grid-alt'></i> Tableau de bord
          </a>
          <a href="/profile/public/<%= user.id %>" class="nav-dropdown-item">
            <i class='bx bx-user-circle'></i> Mon profil public
          </a>
          <% if (user.role === 'admin') { %>
            <div class="nav-dropdown-divider"></div>
            <a href="/admin/dashboard" class="nav-dropdown-item" style="color:#D4AF37;">
              <i class='bx bx-shield-quarter'></i> Panel Admin
            </a>
          <% } %>
          <div class="nav-dropdown-divider"></div>
          <a href="/logout" class="nav-dropdown-item" style="color:#dc3545;">
            <i class='bx bx-log-out'></i> Déconnexion
          </a>
        </div>
      </div>

    <% } else { %>
      <a href="/login" class="nav-link">Connexion</a>
      <a href="/annonces/creer" class="btn btn-nav-primary">Publier une annonce</a>
    <% } %>
  </div>
</nav>
<main style="flex:1;">

<script>
function toggleDropdown() {
  const menu = document.getElementById('navDropdownMenu');
  const chevron = document.getElementById('dropdownChevron');
  const isOpen = menu.classList.toggle('open');
  chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
}

// Fermer si clic en dehors
document.addEventListener('click', (e) => {
  const dropdown = document.getElementById('navDropdown');
  if (dropdown && !dropdown.contains(e.target)) {
    document.getElementById('navDropdownMenu')?.classList.remove('open');
    const chevron = document.getElementById('dropdownChevron');
    if (chevron) chevron.style.transform = 'rotate(0deg)';
  }
});
</script>

<% if (user) { %>
<script src="/socket.io/socket.io.js"></script>
<script>

  window._socket = io({
    auth: { session: { id: '<%= user.id %>' } }
  });

  window._socket.on('conversation_updated', () => majBadgeNav());
  window._socket.on('messages_read', () => majBadgeNav());

  // socket.on('conversation_updated', () => majBadgeNav());
  // socket.on('messages_read', () => majBadgeNav());

  async function majBadgeNav() {
    try {
      const res = await fetch('/messages/badge');
      const { total } = await res.json();
      let badge = document.getElementById('navBadge');

      if (total > 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.id = 'navBadge';
          badge.style.cssText = 'position:absolute; top:-6px; right:-10px; background:#dc3545; color:#fff; border-radius:50%; font-size:9px; font-weight:800; min-width:16px; height:16px; display:flex; align-items:center; justify-content:center; padding:0 3px;';
          document.getElementById('navMessagesLink')?.appendChild(badge);
        }
        badge.textContent = total > 99 ? '99+' : total;
      } else {
        badge?.remove();
      }
    } catch (_) {}
  }
</script>
<% } %>
