<%- include('../partials/header', { title: 'Conversation' }) %>
<%- include('../partials/navbar') %>

<section class="section">
  <div class="container" style="max-width:800px;">

    <!-- En-tête conversation -->
    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
      <a href="/messages" style="color:#D4AF37; font-size:1.2rem;">←</a>
      <div class="conv-avatar" style="width:48px; height:48px; border-radius:50%; background:#D4AF37; display:flex; align-items:center; justify-content:center; font-weight:700; color:#1C1C1E;">
        <%= autreUser ? autreUser.nom.charAt(0).toUpperCase() : '?' %>
      </div>
      <div>
        <h2 style="font-size:1.1rem; font-weight:700;"><%= autreUser ? autreUser.nom : 'Utilisateur' %></h2>
        <% if (annonce) { %>
          <a href="/annonces/<%= annonce.id %>" style="font-size:0.82rem; color:#D4AF37;"><i class='bx bx-home-alt-2 bx-trfm' style="color:var(--gold);"></i> <%= annonce.titre %></a>
        <% } %>
      </div>
    </div>

    <!-- Bulles de messages -->
    <div class="chat-box" id="chatBox">
      <% if (messages.length === 0) { %>
        <div style="text-align:center; color:#6B6B6B; margin:auto;">Démarrez la conversation !</div>
      <% } else { %>
        <% messages.forEach(msg => { %>
          <div style="display:flex; flex-direction:column; align-items:<%= msg.senderId === user.id ? 'flex-end' : 'flex-start' %>;">
            <div class="message-bubble <%= msg.senderId === user.id ? 'sent' : 'received' %>">
              <%= msg.texte %>
            </div>
            <span class="message-time">
              <%= new Date(msg.date).toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' }) %>
              · <%= new Date(msg.date).toLocaleDateString('fr-FR') %>
            </span>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Zone de saisie -->
    <div class="chat-input">
      <input type="text" id="msgInput" class="form-control" placeholder="Écrire un message..." autocomplete="off" style="flex:1;">
      <button id="sendBtn" class="btn btn-gold">Envoyer</button>
    </div>
  </div>
</section>

<!-- <script src="/socket.io/socket.io.js"></script> -->
<script>
  const chatBox = document.getElementById('chatBox');
  const msgInput = document.getElementById('msgInput');
  const sendBtn = document.getElementById('sendBtn');
  const convId = '<%= conv.id %>';
  const userId = '<%= user.id %>';
  const csrfToken = '<%= csrfToken %>';

  // Scroll initial
  if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

  // Réutiliser le socket global créé par header.ejs
  window._socket.emit('join_conversation', convId);
  window._socket.on('new_message', (msg) => {
    if (msg.conversationId !== convId) return;
    appendMessage(msg);
    chatBox.scrollTop = chatBox.scrollHeight;
    fetch(`/messages/${convId}/read`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `_csrf=${encodeURIComponent(csrfToken)}`
    });
  });

  // Après le listener new_message, ajouter :
  window.addEventListener('beforeunload', () => {
    window._socket.emit('leave_conversation', convId);
    window._socket.off('new_message');
  });

  // Envoi message sans reload
  function envoyer() {
    const texte = msgInput.value.trim();
    if (!texte) return;
    msgInput.value = '';

    fetch(`/messages/${convId}/envoyer`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `texte=${encodeURIComponent(texte)}&_csrf=${encodeURIComponent(csrfToken)}`
    });
    // Pas besoin d'ajouter le message ici — il reviendra via socket
  }

  sendBtn.addEventListener('click', envoyer);
  msgInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') envoyer();
  });

  // Ajouter une bulle dans le DOM
  function appendMessage(msg) {
    const isMe = msg.senderId === userId;
    const time = new Date(msg.date).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    const date = new Date(msg.date).toLocaleDateString('fr-FR');

    const wrapper = document.createElement('div');
    wrapper.style.cssText = `display:flex; flex-direction:column; align-items:${isMe ? 'flex-end' : 'flex-start'}`;
    wrapper.innerHTML = `
      <div class="message-bubble ${isMe ? 'sent' : 'received'}">${msg.texte}</div>
      <span class="message-time">${time} · ${date}</span>
    `;
    chatBox.appendChild(wrapper);
  }
</script>

<%- include('../partials/footer') %>
